{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^7.4|^8.0",
        "ext-json": "*",
        "bavix/laravel-wallet": "^7.3",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "google/cloud-firestore": "^1.19",
        "google/protobuf": "^v3.3.0",
        "grpc/grpc": "^1.38",
        "guzzlehttp/guzzle": "^7.0.1",
        "imdhemy/laravel-purchases": "^0.10.3",
        "james-heinrich/getid3": "^1.9",
        "jantinnerezo/livewire-alert": "^2.1",
        "kreait/laravel-firebase": "^3.1",
        "laravel/framework": "^8.40",
        "laravel/passport": "^10.1",
        "laravel/telescope": "^4.6",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^3.3",
        "lcobucci/clock": "2.2",
        "league/flysystem-aws-s3-v3": "~1.0",
        "league/flysystem-cached-adapter": "~1.0",
        "livewire/livewire": "^2.4",
        "matanyadaev/laravel-eloquent-spatial": "^2.10",
        "mediconesystems/livewire-datatables": "^v0.5.2",
        "php-ffmpeg/php-ffmpeg": "^0.18.0",
        "predis/predis": "^2.2",
        "pulkitjalan/geoip": "^5.1",
        "pusher/pusher-php-server": "^7.0",
        "spatie/laravel-image-optimizer": "^1.6",
        "spatie/laravel-medialibrary": "^9.0.0",
        "spatie/laravel-permission": "^4.2",
        "voku/anti-xss": "^4.1"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.8",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block-insecure": false,
            "ignore": {
                "PKSA-tcfz-w4fm-hhk9": "Pinned google/protobuf for Laravel 8 / Firestore stack; upgrade when migrating PHP/Laravel",
                "PKSA-yqjh-6qvh-g493": "Pinned google/protobuf for Laravel 8 / Firestore stack; upgrade when migrating PHP/Laravel"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "provide": { "ext-grpc": "*" }
}
